---
import { getCollection, type CollectionEntry } from "astro:content";
import Base from "../../layouts/Base.astro";
import BookingForm from "../../components/BookingForm.astro";
import { site, booking } from "../../lib/config";

export async function getStaticPaths() {
  const tours = await getCollection("tours", ({ data }) => !data.draft);
  // Sort on a copy, once, before mapping. Sorting inside the map mutates the
  // array mid-iteration and produces duplicate routes.
  const all = [...tours].sort((a, b) => a.data.order - b.data.order);
  return all.map((tour) => ({
    params: { slug: tour.slug },
    props: { tour, all },
  }));
}

interface Props {
  tour: CollectionEntry<"tours">;
  all: CollectionEntry<"tours">[];
}

const { tour, all } = Astro.props;
const { Content } = await tour.render();
const formTours = all.map((t) => ({ slug: t.slug, title: t.data.shortTitle }));

// Book this trip specifically. Falls back to the enquiry form when the tour
// has no Cal event yet, so a half-configured trip still takes bookings.
const calUrl = tour.data.calEvent
  ? `${booking.calBase}/${tour.data.calEvent}`
  : null;
---

<Base title={`${tour.data.title} — ${site.name}`} description={tour.data.summary}>
  <header class="th" data-has-image={tour.data.hero ? "true" : "false"}>
    {
      tour.data.hero && (
        <img class="th__img" src={tour.data.hero} alt="" width="1600" height="900" fetchpriority="high" />
      )
    }
    <div class="wrap">
      <a class="th__back" href="/">Back to both trips</a>
      <h1>{tour.data.title}</h1>
      <p class="th__facts">
        {tour.data.duration} · {tour.data.groupSize.min}–{tour.data.groupSize.max}
        {" "}guests · {tour.data.season.from} to {tour.data.season.to}
      </p>
    </div>
  </header>

  <main id="main">
    <section class="body">
      <div class="wrap body__inner">
        <div class="prose"><Content /></div>

        <aside class="incl">
          {
            tour.data.price.includes.length > 0 && (
              <>
                <h2 class="incl__h">Included</h2>
                <ul>
                  {tour.data.price.includes.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              </>
            )
          }
          {
            tour.data.price.excludes.length > 0 && (
              <>
                <h2 class="incl__h">Not included</h2>
                <ul class="incl__no">
                  {tour.data.price.excludes.map((i) => (
                    <li>{i}</li>
                  ))}
                </ul>
              </>
            )
          }
        </aside>
      </div>
    </section>

    {
      tour.data.itinerary.length > 0 && (
        <section class="plan" aria-labelledby="plan-h">
          <div class="wrap">
            <p class="eyebrow">Downstream</p>
            <h2 id="plan-h">How the day runs</h2>

            <ol class="plan__list">
              {tour.data.itinerary.map((stop) => (
                <li class="stop">
                  <div class="stop__when">
                    {stop.minutes ? `${stop.minutes} min` : ""}
                  </div>
                  <div class="stop__what">
                    <h3>{stop.title}</h3>
                    <p>{stop.detail}</p>
                  </div>
                </li>
              ))}
            </ol>
          </div>
        </section>
      )
    }

    <section class="book" id="book">
      <div class="wrap book__inner">
        <div>
          <p class="eyebrow">Booking</p>
          <h2>Pick a time</h2>
          <p>
            {calUrl
              ? "Open times for this trip only. Nothing is charged now."
              : "Send a date and I'll confirm whether it's free."}
          </p>
        </div>

        <div>
          {calUrl ? (
            <div class="cal">
              <iframe
                class="cal__frame"
                src={calUrl}
                title={`Book ${tour.data.shortTitle}`}
                loading="lazy"
                allow="camera; microphone; autoplay; fullscreen; clipboard-write; payment"
              ></iframe>
              <p class="cal__note">{booking.note}</p>

              <details class="cal__alt">
                <summary>Rather send a message instead?</summary>
                <div class="cal__altinner">
                  <BookingForm tours={formTours} selected={tour.slug} />
                </div>
              </details>
            </div>
          ) : (
            <BookingForm tours={formTours} selected={tour.slug} />
          )}
        </div>
      </div>
    </section>
  </main>
</Base>

<style>
  .th {
    background: var(--ground);
    color: var(--cream);
    padding: clamp(3rem, 9vh, 6rem) 0 clamp(2.5rem, 7vh, 4.5rem);
    position: relative;
    isolation: isolate;
    overflow: hidden;
  }
  .th[data-has-image="true"] {
    padding-top: clamp(5rem, 20vh, 9rem);
  }
  .th::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    background: linear-gradient(
      6deg,
      rgba(9, 26, 30, 0.95) 0%,
      rgba(9, 26, 30, 0.72) 40%,
      rgba(9, 26, 30, 0.2) 75%,
      rgba(9, 26, 30, 0.4) 100%
    );
  }
  .th__img {
    position: absolute;
    inset: 0;
    z-index: -2;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 55%;
  }
  .th h1 {
    color: var(--cream);
    max-width: 18ch;
    text-shadow: 0 2px 28px rgba(6, 18, 22, 0.5);
  }
  .th__back {
    display: inline-block;
    font-size: 0.86rem;
    font-weight: 600;
    color: var(--amber);
    margin-bottom: 1.6rem;
  }
  .th__facts {
    margin: 1.3rem 0 0;
    color: var(--cream);
    font-size: 0.95rem;
    text-shadow: 0 1px 16px rgba(6, 18, 22, 0.6);
  }

  .body {
    padding: var(--rhythm) 0 0;
  }
  .body__inner {
    display: grid;
    grid-template-columns: minmax(0, 3fr) minmax(0, 2fr);
    gap: 3rem;
    align-items: start;
  }
  .prose :global(p) {
    font-size: 1.06rem;
  }

  .incl {
    border-top: 2px solid var(--amber);
    padding-top: 1.2rem;
  }
  .incl__h {
    font-family: var(--body);
    font-size: 0.86rem;
    font-weight: 700;
    margin: 1.3rem 0 0.5rem;
  }
  .incl__h:first-child {
    margin-top: 0;
  }
  .incl ul {
    margin: 0;
    padding-left: 1.1rem;
    font-size: 0.95rem;
  }
  .incl__no {
    color: var(--cream-dim);
  }

  .plan {
    padding: var(--rhythm) 0;
  }
  .plan__list {
    list-style: none;
    margin: 2.5rem 0 0;
    padding: 0;
  }
  .stop {
    display: grid;
    grid-template-columns: 6rem minmax(0, 1fr);
    gap: 1.5rem;
    padding: 1.6rem 0;
    border-top: 1px solid var(--line);
  }
  .stop__when {
    font-size: 0.82rem;
    font-weight: 700;
    color: var(--amber);
    padding-top: 0.28rem;
  }
  .stop__what p {
    margin: 0.5rem 0 0;
  }

  .book {
    background: var(--ground-lift);
    color: var(--cream-dim);
    padding: var(--rhythm) 0;
    border-top: 1px solid var(--line);
  }
  .book h2 {
    color: var(--cream);
  }
  .book__inner {
    display: grid;
    grid-template-columns: minmax(0, 2fr) minmax(0, 3fr);
    gap: 3rem;
    align-items: start;
  }
  .book p {
    margin-top: 1.2rem;
  }

  /* ---------- Cal embed ---------- */
  .cal__frame {
    width: 100%;
    height: clamp(38rem, 78vh, 46rem);
    border: 0;
    border-radius: 10px;
    background: var(--paper);
    display: block;
  }
  .cal__note {
    margin: 0.85rem 0 0;
    font-size: 0.86rem;
    color: var(--cream-dim);
  }
  .cal__alt {
    margin-top: 1.4rem;
    border-top: 1px solid var(--line);
    padding-top: 1.1rem;
  }
  .cal__alt summary {
    cursor: pointer;
    font-size: 0.92rem;
    font-weight: 600;
    color: var(--amber);
    list-style: none;
  }
  .cal__alt summary::-webkit-details-marker {
    display: none;
  }
  .cal__alt summary::before {
    content: "+ ";
  }
  .cal__alt[open] summary::before {
    content: "\2212 ";
  }
  .cal__altinner {
    margin-top: 1.1rem;
  }

  @media (max-width: 52rem) {
    .body__inner,
    .book__inner {
      grid-template-columns: 1fr;
    }
    .stop {
      grid-template-columns: 1fr;
      gap: 0.4rem;
    }
  }
</style>
