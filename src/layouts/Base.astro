---
import "../styles/global.css";
import { site, captain, social, boat, meetingPoint, images } from "../lib/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  image = "/img/og.jpg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();

// Structured data. Search engines — and increasingly assistants — read this
// to answer "boat tour Belgrade" without a click. It reads from config, so
// it can't drift out of date.
const schema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  name: site.name,
  description: site.description,
  url: site.url,
  address: {
    "@type": "PostalAddress",
    addressLocality: site.city,
    addressCountry: site.country,
  },
  geo: {
    "@type": "GeoCoordinates",
    latitude: meetingPoint.lat,
    longitude: meetingPoint.lng,
  },
  sameAs: [social.instagram, social.tiktok].filter(Boolean),
};

const socialLinks = [
  social.instagram ? { label: "Instagram", href: social.instagram } : null,
  social.tiktok ? { label: "TikTok", href: social.tiktok } : null,
].filter((l): l is { label: string; href: string } => l !== null);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,500;12..96,75..100,600;12..96,75..100,700&family=Archivo:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <slot />

    <footer class="foot">
      <div class="wrap foot__inner">
        <div class="foot__brand">
          {images.logo && (
            <img class="foot__logo" src={images.logo} alt={`${site.name} logo`} width="240" height="240" loading="lazy" />
          )}
          <p class="foot__name">{site.name}</p>
          <p class="foot__meta">
            {meetingPoint.label}, {site.city}<br />
            {boat.type}, {boat.hull}, up to {boat.maxGuests} guests
          </p>
        </div>

        <nav class="foot__links" aria-label="Contact and social">
          <a href={`mailto:${captain.email}`}>{captain.email}</a>
          <a href={`tel:${captain.phoneE164}`}>{captain.phone}</a>
          {socialLinks.map((l) => <a href={l.href}>{l.label}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .foot {
    background: var(--ground);
    color: var(--cream-dim);
    padding: var(--rhythm) 0 2.5rem;
    border-top: 1px solid var(--line);
  }
  .foot__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 2.5rem;
    justify-content: space-between;
  }
  .foot__logo {
    width: clamp(4.5rem, 9vw, 6.5rem);
    height: auto;
    margin-bottom: 1rem;
    /* Knocked out to cream so it sits on the dark ground. */
    filter: brightness(0) invert(1);
    opacity: 0.9;
  }

  .foot__name {
    font-family: var(--display);
    font-size: 1.35rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--cream);
    margin: 0 0 0.4rem;
  }
  .foot__meta {
    font-size: 0.9rem;
    margin: 0;
    line-height: 1.7;
  }
  .foot__links {
    display: grid;
    gap: 0.45rem;
    font-size: 0.92rem;
    align-content: start;
  }
  .foot__links a {
    color: var(--cream-dim);
    text-decoration: none;
  }
  .foot__links a:hover {
    color: var(--amber);
    text-decoration: underline;
  }
</style>
