---
import "../styles/global.css";
import { getCollection } from "astro:content";
import MeetingPoint from "../components/MeetingPoint.astro";
import { site, captain, social, boat, meetingPoint, images } from "../lib/config";

interface Props {
  title?: string;
  description?: string;
  image?: string;
}

const {
  title = `${site.name} — ${site.tagline}`,
  description = site.description,
  image = "/img/og.jpg",
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site ?? site.url).toString();

const tours = (await getCollection("tours", ({ data }) => !data.draft)).sort(
  (a, b) => a.data.order - b.data.order,
);

// Structured data. Search engines — and increasingly assistants — read this
// to answer "boat tour Belgrade" without a click. It reads from config, so
// it can't drift out of date.
const schema = {
  "@context": "https://schema.org",
  "@type": "TouristAttraction",
  name: site.name,
  description: site.description,
  url: site.url,
  telephone: captain.phoneE164,
  email: captain.email,
  address: {
    "@type": "PostalAddress",
    streetAddress: meetingPoint.address,
    addressLocality: site.city,
    addressCountry: site.country,
  },
  hasMap: `https://www.google.com/maps/search/?api=1&query=${meetingPoint.lat},${meetingPoint.lng}`,
  geo: {
    "@type": "GeoCoordinates",
    latitude: meetingPoint.lat,
    longitude: meetingPoint.lng,
  },
  sameAs: [social.instagram, social.tiktok, social.airbnb, social.getyourguide].filter(Boolean),
};

const socialLinks = [
  social.instagram ? { label: "Instagram", href: social.instagram } : null,
  social.tiktok ? { label: "TikTok", href: social.tiktok } : null,
  social.airbnb ? { label: "Airbnb", href: social.airbnb } : null,
  social.getyourguide ? { label: "GetYourGuide", href: social.getyourguide } : null,
].filter((l): l is { label: string; href: string } => l !== null);

// wa.me and viber: links both take the number without a plus or spaces.
const digits = captain.phoneE164.replace(/\D/g, "");
const year = new Date().getFullYear();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={new URL(image, site.url).toString()} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wdth,wght@12..96,75..100,500;12..96,75..100,600;12..96,75..100,700&family=Archivo:wght@400;500;600;700&display=swap"
    />

    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>

  <body>
    <a class="skip" href="#main">Skip to content</a>

    <slot />

    <MeetingPoint />

    <footer class="foot">
      <div class="wrap foot__grid">
        <div class="foot__brand">
          {images.logo && (
            <img class="foot__logo" src={images.logo} alt={`${site.name} logo`} width="240" height="240" loading="lazy" />
          )}
          <p class="foot__name">{site.name}</p>
          <p class="foot__meta">
            {meetingPoint.label}, {site.city}<br />
            {boat.type}, {boat.hull}<br />
            {boat.guestsLabel}
          </p>
        </div>

        <nav class="foot__col" aria-label="Trips">
          <h2 class="foot__h">Trips</h2>
          <ul class="foot__list">
            {tours.map((t) => (
              <li><a href={`/tours/${t.slug}/`}>{t.data.shortTitle}</a></li>
            ))}
          </ul>
        </nav>

        <div class="foot__col foot__talk">
          <h2 class="foot__h">Talk to me</h2>

          <a class="foot__phone" href={`tel:${captain.phoneE164}`}>{captain.phone}</a>

          <div class="chat">
            <a class="chat__btn chat__btn--wa" href={`https://wa.me/${digits}`} rel="noopener">
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12.04 2A9.9 9.9 0 0 0 2.14 11.9c0 1.75.46 3.46 1.34 4.97L2 22l5.25-1.44a9.86 9.86 0 0 0 4.79 1.22h.01a9.9 9.9 0 0 0 9.9-9.9A9.9 9.9 0 0 0 12.04 2Zm0 18.02h-.01a8.2 8.2 0 0 1-4.18-1.15l-.3-.18-3.11.85.83-3.04-.2-.31a8.2 8.2 0 0 1-1.26-4.39 8.23 8.23 0 1 1 8.23 8.22Zm4.51-6.16c-.25-.12-1.46-.72-1.69-.8-.22-.09-.39-.13-.55.12-.16.25-.63.8-.78.97-.14.16-.29.18-.53.06-.25-.12-1.04-.39-1.99-1.23-.73-.66-1.23-1.46-1.37-1.71-.15-.25-.02-.38.11-.5.11-.11.25-.29.37-.43.12-.15.16-.25.25-.41.08-.17.04-.31-.02-.43-.06-.12-.55-1.34-.76-1.83-.2-.48-.4-.42-.55-.42h-.47c-.16 0-.43.06-.65.31-.23.25-.86.84-.86 2.05s.88 2.38 1 2.54c.13.17 1.74 2.66 4.22 3.73.59.25 1.05.4 1.41.52.59.18 1.13.16 1.56.1.47-.07 1.46-.6 1.66-1.18.21-.58.21-1.07.15-1.18-.06-.1-.22-.16-.47-.28Z"/>
              </svg>
              WhatsApp
            </a>

            <a class="chat__btn chat__btn--vb" href={`viber://chat?number=%2B${digits}`}>
              <svg viewBox="0 0 24 24" width="17" height="17" aria-hidden="true" focusable="false">
                <path fill="currentColor" d="M12 2C8.6 2 6.5 2.3 5.3 3.4 4.1 4.5 3.5 6.3 3.5 9v2.4c0 2.7.6 4.5 1.8 5.6.5.5 1.2.8 2 1v2.6c0 .5.6.7.9.4l2.2-2.4h1.6c3.4 0 5.5-.3 6.7-1.4 1.2-1.1 1.8-2.9 1.8-5.6V9c0-2.7-.6-4.5-1.8-5.6C17.5 2.3 15.4 2 12 2Zm3.9 12.7c-.2.5-.9.9-1.4 1-.3 0-.7.1-2.1-.5-1.8-.7-2.9-2.5-3-2.6-.1-.1-.7-.9-.7-1.8s.4-1.2.6-1.4c.1-.2.3-.2.4-.2h.3c.1 0 .3 0 .4.3l.6 1.4c.1.1 0 .3 0 .4l-.2.2-.2.3s-.1.1 0 .3c.1.2.5.8 1 1.3.7.6 1.2.8 1.4.9.1 0 .2 0 .3-.1l.6-.7c.1-.2.3-.1.4-.1l1.3.6c.2.1.3.2.3.2.1.1.1.4 0 .7ZM12 5.6c-.3 0-.5.2-.5.5s.2.5.5.5c2 0 3.6 1.6 3.6 3.6 0 .3.2.5.5.5s.5-.2.5-.5c0-2.5-2.1-4.6-4.6-4.6Zm.1 1.9c-.3 0-.5.2-.5.5s.2.5.5.5c1 0 1.8.8 1.8 1.8 0 .3.2.5.5.5s.5-.2.5-.5c0-1.5-1.3-2.8-2.8-2.8Z"/>
              </svg>
              Viber
            </a>
          </div>

          <p class="foot__handle">{captain.handle}</p>
          <a class="foot__mail" href={`mailto:${captain.email}`}>{captain.email}</a>
        </div>
      </div>

      <div class="wrap foot__bar">
        <p>© {year} {site.name} · {site.domain}</p>
        <nav class="foot__social" aria-label="Elsewhere">
          {socialLinks.map((l) => <a href={l.href} rel="noopener">{l.label}</a>)}
        </nav>
      </div>
    </footer>
  </body>
</html>

<style>
  .foot {
    background: var(--ground-lift);
    color: var(--cream-dim);
    padding: var(--rhythm) 0 1.6rem;
    border-top: 1px solid var(--line);
  }

  .foot__grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr) minmax(0, 1.2fr);
    gap: 2.5rem 3rem;
    align-items: start;
  }

  .foot__logo {
    width: clamp(4rem, 7vw, 5.5rem);
    height: auto;
    margin-bottom: 0.9rem;
    /* Knocked out to cream so it sits on the dark ground. */
    filter: brightness(0) invert(1);
    opacity: 0.92;
  }
  .foot__name {
    font-family: var(--display);
    font-size: 1.3rem;
    font-weight: 600;
    letter-spacing: -0.02em;
    color: var(--cream);
    margin: 0 0 0.35rem;
  }
  .foot__meta {
    font-size: 0.86rem;
    line-height: 1.65;
    margin: 0;
    max-width: 30ch;
  }

  .foot__h {
    font-family: var(--body);
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--amber);
    margin: 0 0 0.9rem;
  }

  .foot__list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.5rem;
    font-size: 0.9rem;
  }
  .foot__list a {
    color: var(--cream-dim);
    text-decoration: none;
  }
  .foot__list a:hover {
    color: var(--cream);
    text-decoration: underline;
  }

  /* --- The number is the point of the footer, so it is sized like it --- */
  .foot__phone {
    display: inline-block;
    font-family: var(--display);
    font-size: clamp(1.35rem, 2.4vw, 1.75rem);
    font-weight: 700;
    letter-spacing: -0.02em;
    color: var(--cream);
    text-decoration: none;
    margin-bottom: 0.9rem;
  }
  .foot__phone:hover {
    color: var(--amber);
  }

  .chat {
    display: flex;
    flex-wrap: wrap;
    gap: 0.55rem;
    margin-bottom: 1.1rem;
  }
  .chat__btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    font-size: 0.86rem;
    font-weight: 700;
    padding: 0.5rem 0.95rem;
    border-radius: 100px;
    text-decoration: none;
    color: #0b1e22;
    transition: filter 150ms ease;
  }
  .chat__btn:hover {
    filter: brightness(1.12);
  }
  .chat__btn--wa {
    background: #25d366;
  }
  .chat__btn--vb {
    background: #a68cf5;
  }

  .foot__handle {
    font-family: var(--display);
    font-size: 1rem;
    font-weight: 600;
    color: var(--amber);
    margin: 0 0 0.35rem;
  }
  .foot__mail {
    font-size: 0.9rem;
    color: var(--cream-dim);
    text-decoration: none;
  }
  .foot__mail:hover {
    color: var(--cream);
    text-decoration: underline;
  }

  .foot__bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.8rem 2rem;
    margin-top: var(--rhythm);
    padding-top: 1.3rem;
    border-top: 1px solid var(--line);
    font-size: 0.8rem;
  }
  .foot__bar p {
    margin: 0;
    max-width: none;
  }
  .foot__social {
    display: flex;
    flex-wrap: wrap;
    gap: 1.2rem;
  }
  .foot__social a {
    color: var(--cream-dim);
    text-decoration: none;
  }
  .foot__social a:hover {
    color: var(--amber);
    text-decoration: underline;
  }

  @media (max-width: 54rem) {
    .foot__grid {
      grid-template-columns: 1fr 1fr;
    }
    .foot__brand {
      grid-column: 1 / -1;
    }
  }

  @media (max-width: 34rem) {
    .foot__grid {
      grid-template-columns: 1fr;
      gap: 2rem;
    }
  }
</style>
