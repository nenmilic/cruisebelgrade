# Copy to .env for local dev. In production these go in
# Cloudflare Pages > Settings > Environment variables (encrypted).
#
# Every channel is optional. Configure the ones you want; the rest skip
# themselves without breaking anything.

# --- Email (Resend, free up to 3000/month) ---
RESEND_API_KEY=
NOTIFY_EMAIL_TO=nenad@example.com
NOTIFY_EMAIL_FROM=bookings@cruisebelgrade.rs

# --- Telegram (free, instant push to your phone) ---
# @BotFather to create the bot; api.telegram.org/bot<TOKEN>/getUpdates for the id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- SMS (Twilio, a few cents per message) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
NOTIFY_SMS_TO=+381XXXXXXXXX
